<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet settings for this solution: it does not depend on the sources of the global NuGet.Config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- packages.config: packages go to .\packages, where the HintPath entries of the .csproj files point -->
    <add key="repositoryPath" value="packages" />
  </config>
</configuration>
